{
  "manifest_version": 3,
  "name": "Zop Poster",
  "author": "DCZ3R0",
  "version": "1.0.0",
  "description": "This plugin is designed to help you post your inventories on FB Marketplace with minimal efforts. It is powered by ZOP.",
  "icons": {
    "32": "images/chrome_icon_tight_32.png",
    "48": "images/chrome_icon_tight_48.png",
    "128": "images/chrome_icon_tight_128.png"
  },
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://*.facebook.com/*",
    "https://*.zopsoftware.com/*",
    "https://*.zopsoftwareus.com/*"
  ],
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "scripting"]
}
